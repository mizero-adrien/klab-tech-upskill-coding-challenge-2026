# Shared values used by docker-compose to configure the db and backend
# services together. Copy this file to `.env` (same folder as
# docker-compose.yml) and fill in real values for local use.

# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Postgres (used by both the `db` container and the backend's DB_* settings)
DB_NAME=taskmanager
DB_USER=taskmanager
DB_PASSWORD=taskmanager
# Host port that Postgres is published on (change if 5432 is already taken
# on your machine by another local Postgres instance/container)
DB_PORT=5432

# CORS - comma separated list of origins allowed to call the API
# (include both localhost and 127.0.0.1 - browsers treat them as different origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend - the API base URL the BROWSER will call (not a Docker service
# name, since NEXT_PUBLIC_ variables end up in client-side JS)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
